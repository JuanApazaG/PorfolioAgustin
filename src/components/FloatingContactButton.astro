---
interface Props {}
---

<div class="fixed bottom-6 right-6 z-40">
  <button 
    onclick="openContactModal()"
    class="group bg-yellow-400 hover:bg-yellow-500 text-gray-900 p-4 rounded-full shadow-2xl transform transition-all duration-300 hover:scale-110 focus:ring-4 focus:ring-yellow-400/50 focus:outline-none"
    title="Contáctame"
    aria-label="Abrir formulario de contacto"
  >
    <iconify-icon 
      icon="carbon:email" 
      width="24" 
      height="24" 
      class="transition-transform group-hover:scale-110"
    ></iconify-icon>
  </button>
  
  <!-- Tooltip -->
  <div class="absolute bottom-full right-0 mb-2 px-3 py-2 bg-gray-900 dark:bg-gray-700 text-white text-sm rounded-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 whitespace-nowrap">
    ¡Hablemos!
    <div class="absolute top-full right-4 w-0 h-0 border-l-4 border-r-4 border-t-4 border-transparent border-t-gray-900 dark:border-t-gray-700"></div>
  </div>
</div>

<style>
  /* Animación de pulso sutil para llamar la atención */
  @keyframes pulse-subtle {
    0%, 100% {
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(251, 191, 36, 0.4);
    }
    50% {
      transform: scale(1.05);
      box-shadow: 0 0 0 10px rgba(251, 191, 36, 0);
    }
  }
  
  button {
    animation: pulse-subtle 3s infinite;
  }
  
  button:hover {
    animation: none;
  }
</style>