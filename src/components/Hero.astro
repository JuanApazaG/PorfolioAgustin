---
import Badge from "@/components/Badge.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"
import FacebookIcon from "@/components/icons/Facebook.astro"
import TiktokIcon from "@/components/icons/Tiktok.astro"
import InstagramIcon from "@/components/icons/Instagram.astro"
import SocialPill from "@/components/SocialPill.astro"
---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <img
      class="rounded-full shadow-lg size-24"
      src="/agustin.webp"
    />
    <a
      href="https://www.linkedin.com/in/juan-agustin-apaza-537015286/"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>Disponible</Badge>
    </a>
  </div>
  <h1
    class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
    👋 Hola, soy Juan Agustín Apaza
  </h1>
  <p
    class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-yellow-200 [&>strong]:text-yellow-500 [&>strong]:font-semibold dark:text-gray-300"
  >
  Mobile Developer & Estudiante de Ingeniería de Sistemas en Sucre, Bolivia. <strong
      >Apasionado por la tecnología, la inteligencia artificial y la automatización,</strong
    > desarrollo aplicaciones móviles con Flutter y soluciones con Python, IA y n8n.
  </p>
  <nav class="flex flex-wrap gap-4 mt-8">
    <SocialPill href="https://www.linkedin.com/in/juan-agustin-apaza-guzman-537015286/">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
    <SocialPill href="https://www.instagram.com/juan_agustin_apaza/">
      <InstagramIcon class="size-4" />
      Instagram
    </SocialPill>
    <SocialPill href="https://www.facebook.com/JuanAgustin95">
      <FacebookIcon class="size-4" />
      Facebook
    </SocialPill>
     <SocialPill href="https://www.tiktok.com/@juanagustinapaza">
      <TiktokIcon class="size-4" />
      Tiktok
    </SocialPill>
  </nav>
</div>
