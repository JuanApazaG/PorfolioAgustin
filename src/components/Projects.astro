---
import GitHub from "./icons/GitHub.astro"
import Link from "./icons/Link.astro"
import LinkButton from "./LinkButton.astro"

const TAGS = {
  FLUTTER: {
    name: "Flutter",
    class: "bg-blue-500 text-white",
    icon: "devicon:flutter",
  },
  AI: {
    name: "Inteligencia Artificial",
    class: "bg-purple-600 text-white",
    icon: "carbon:machine-learning-model",
  },
  PYTHON: {
    name: "Python",
    class: "bg-green-600 text-white",
    icon: "devicon:python",
  },
  GEMINI: {
    name: "Gemini AI",
    class: "bg-gradient-to-r from-blue-600 to-purple-600 text-white",
    icon: "simple-icons:googlegemini",
  },
  WHISPER: {
    name: "Whisper",
    class: "bg-gray-800 text-white",
    icon: "simple-icons:openai",
  },
  WEB: {
    name: "Web Development",
    class: "bg-orange-500 text-white",
    icon: "carbon:web-services-definition",
  },
  N8N: {
    name: "n8n",
    class: "bg-red-500 text-white",
    icon: "simple-icons:n8n",
  },
  AUTOMATION: {
    name: "Automatización",
    class: "bg-indigo-600 text-white",
    icon: "carbon:automation",
  },
}

const PROJECTS = [
  {
    title: "Juli - Informes Clínicos con IA",
    description: "App móvil ganadora del 1er lugar en Build With AI Bolivia. Genera informes clínicos automáticos utilizando Whisper para transcripción de voz y Gemini 2.5 Pro para análisis médico. Desarrollada con Flutter.",
    link: "#", // Agregar link cuando esté disponible
    github: "#", // Agregar GitHub cuando esté disponible
    image: "/projects/logoJuli.png", // Placeholder temporal
    tags: [TAGS.FLUTTER, TAGS.AI, TAGS.WHISPER, TAGS.GEMINI],
    award: "🏆 1er Lugar - Hackathon Nacional",
    status: "featured"
  },
  {
    title: "YuraVisión - Diagnóstico Agrícola",
    description: "App móvil desarrollada para Incuba Unión del Banco Unión. Utiliza inteligencia artificial para diagnosticar plagas agrícolas a través de análisis de imágenes. Finalista Top 10 a nivel nacional.",
    link: "#", // Agregar link cuando esté disponible
    github: "#", // Agregar GitHub cuando esté disponible
    image: "/projects/yura1.2.png", // Placeholder temporal
    tags: [TAGS.FLUTTER, TAGS.AI],
    award: "🥇 Finalista Top 10 Nacional",
    status: "featured"
  },
  {
    title: "Sumakhub - Plataforma para Nómadas Digitales",
    description: "Plataforma web innovadora desarrollada para TechConnect con respaldo de la Embajada de Estados Unidos. Conecta nómadas digitales y estudiantes con espacios de coworking.",
    link: "#", // Agregar link cuando esté disponible
    github: "#", // Agregar GitHub cuando esté disponible
    image: "/projects/sumakhubfoto.png", // Placeholder temporal
    tags: [TAGS.WEB, TAGS.PYTHON],
    award: "🇺🇸 Respaldado por Embajada EE.UU.",
    status: "featured"
  },
  {
    title: "Automatizaciones Inteligentes",
    description: "Desarrollo de workflows automatizados utilizando n8n y Python para optimizar procesos empresariales. Integración con APIs, bases de datos y servicios en la nube.",
    link: "#", // Agregar link cuando esté disponible
    github: "#", // Agregar GitHub cuando esté disponible
    image: "/projects/clasificadorn8n.png", // Placeholder temporal
    tags: [TAGS.N8N, TAGS.PYTHON, TAGS.AUTOMATION],
    status: "active"
  },
]
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, title, description, tags, link, github, award, status }) => (
    <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
  <div class="w-full md:w-1/2">
    <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
      <img alt={title} class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105" loading="lazy" src={image} />
    </div>
  </div>

  <div class="w-full md:w-1/2 md:max-w-lg">
    <div class="flex items-start justify-between">
      <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
        {title}
      </h3>
      {status === "featured" && (
        <span class="text-yellow-400 text-sm font-semibold bg-yellow-400/10 px-2 py-1 rounded-full ml-2">
          ⭐ Destacado
        </span>
      )}
    </div>
    
    {award && (
      <div class="mt-2 mb-3">
        <span class="text-yellow-400 text-sm font-medium bg-yellow-400/10 px-3 py-1 rounded-full">
          {award}
        </span>
      </div>
    )}
    
    <div class="flex flex-wrap mt-2">
      <ul class="flex flex-row mb-2 gap-x-2">
          {tags.map((tag) => (
            <li>
              <span
                class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 `}
              >
                <iconify-icon icon={tag.icon} width="16" height="16"></iconify-icon>
                {tag.name}
              </span>
            </li>
          ))}
        </ul>

      <div class="mt-2 text-gray-700 dark:text-gray-400">{description}</div>
      <footer class="flex items-end justify-start mt-4 gap-x-4">
          {github && github !== "#" && (
            <LinkButton href={github}>
              <GitHub class="size-6" />
              Código
            </LinkButton>
          )}
          {link && link !== "#" && (
            <LinkButton href={link}>
              <Link class="size-4" />
              Ver Demo
            </LinkButton>
          )}
          {(link === "#" || github === "#") && (
            <span class="text-sm text-gray-500 dark:text-gray-400 italic">
              🚧 Próximamente disponible
            </span>
          )}
        </footer>
    </div>
  </div>
</article>
    ))
  }
</div>



