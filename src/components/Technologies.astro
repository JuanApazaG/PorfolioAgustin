---
interface Props {}

// Usando Iconify para iconos profesionales y oficiales
const TECHNOLOGIES = [
  {
    category: "Lenguajes y Frameworks",
    items: [
      { name: "Flutter", icon: "devicon:flutter", level: "Avanzado" },
      { name: "Dart", icon: "devicon:dart", level: "Avanzado" },
      { name: "Python", icon: "devicon:python", level: "Intermedio" },
      { name: "JavaScript", icon: "devicon:javascript", level: "Intermedio" },
      { name: "TypeScript", icon: "devicon:typescript", level: "Intermedio" },
      { name: "PHP", icon: "devicon:php", level: "Básico" },
    ]
  },
  {
    category: "Inteligencia Artificial y Automatización",
    items: [
      { name: "Gemini 2.5 Pro", icon: "simple-icons:googlegemini", level: "Avanzado" },
      { name: "Whisper", icon: "simple-icons:openai", level: "Intermedio" },
      { name: "IA con Python", icon: "carbon:machine-learning-model", level: "Intermedio" },
      { name: "n8n", icon: "simple-icons:n8n", level: "Básico" },
    ]
  },
  {
    category: "Bases de Datos",
    items: [
      { name: "Firebase", icon: "devicon:firebase", level: "Intermedio" },
      { name: "SQLite", icon: "devicon:sqlite", level: "Básico" },
    ]
  },
  {
    category: "Herramientas",
    items: [
      { name: "Git", icon: "devicon:git", level: "Intermedio" },
      { name: "Figma", icon: "devicon:figma", level: "Intermedio" },
      { name: "Notion", icon: "simple-icons:notion", level: "Intermedio" },
      { name: "APIs REST", icon: "carbon:api", level: "Intermedio" },
    ]
  }
]

const getLevelColor = (level: string) => {
  switch(level) {
    case "Avanzado": return "bg-green-500/80 text-green-100"
    case "Intermedio": return "bg-yellow-500/80 text-yellow-100"
    case "Básico": return "bg-gray-500/80 text-gray-100"
    default: return "bg-gray-500/80 text-gray-100"
  }
}


---

<div class="space-y-12 mt-16">
  {
    TECHNOLOGIES.map(({ category, items }) => (
      <div>
        <h3 class="text-2xl font-bold text-yellow-400 mb-6 flex items-center gap-2">
          <span class="text-yellow-400">#</span>{category}
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
          {items.map(({ name, icon, level }) => (
            <div class="group">
              <div class="relative p-6 bg-white/5 dark:bg-gray-800/30 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-yellow-400/50 dark:hover:border-yellow-400/50 transition-all duration-300 hover:shadow-lg hover:shadow-yellow-400/10 hover:-translate-y-1">
                <div class="flex flex-col items-center text-center space-y-3">
                  <div class="text-yellow-400 mb-1">
                    <iconify-icon icon={icon} width="32" height="32"></iconify-icon>
                  </div>
                  <h4 class="font-semibold text-gray-800 dark:text-white text-sm">{name}</h4>
                  <span class={`text-xs px-2 py-1 rounded-full font-medium ${getLevelColor(level)}`}>
                    {level}
                  </span>
                </div>
                
                {/* Efecto de brillo al hacer hover */}
                <div class="absolute inset-0 bg-gradient-to-r from-yellow-400/0 via-yellow-400/5 to-yellow-400/0 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))
  }
</div>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-2px); }
  }
  
  .group:hover {
    animation: float 2s ease-in-out infinite;
  }
</style>